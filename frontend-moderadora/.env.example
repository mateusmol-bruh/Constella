# URL interna do backend Express. No navegador, chamadas usam /api/backend.
BACKEND_URL=http://localhost:3000

# Opcional: para enviar vídeos de conteúdos PRO diretamente ao Cloudinary.
# Crie um upload preset UNSIGNED no painel do Cloudinary. Não coloque a API_SECRET aqui!
# Defina permissões, formatos e tamanho máximo no preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
