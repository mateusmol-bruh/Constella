DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/Constella?schema=public"
JWT_SECRET=""
PORT=3000
NODE_ENV=development
# Produção: usar NODE_ENV=production e um JWT_SECRET aleatório de ao menos 32 bytes.
# CORS: origens web completas separadas por vírgulas, sem caminho; HTTPS em produção.
# Vazio em produção bloqueia origens web. Aplicativos nativos sem Origin são permitidos.
# Em desenvolvimento, localhost/127.0.0.1/[::1] via HTTP são permitidos pelo servidor.
CORS_ALLOWED_ORIGINS=""
# false para acesso direto; 1 somente se todo tráfego passar por um proxy confiável.
TRUST_PROXY=false
# Ative somente após confirmar que DATABASE_URL aponta para desenvolvimento.
ALLOW_DEVELOPMENT_SEED=false
# Defina localmente: pelo menos 12 caracteres, no máximo 72 bytes. Não versione.
SEED_PASSWORD=""
# Habilite somente após aplicar a migration push e configurar o build/credenciais do Expo.
CONSTELLA_PUSH_ENABLED=false
# Opcional: access token do Expo para enhanced push security. Nunca usar EXPO_PUBLIC_ aqui.
EXPO_PUSH_ACCESS_TOKEN=""
