{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "CONSTELLA_DISTRIBUTION": "1",
        "CONSTELLA_LAN_BUILD": "1",
        "EXPO_PUBLIC_API_URL": "http://192.168.15.30:3000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "CONSTELLA_DISTRIBUTION": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
