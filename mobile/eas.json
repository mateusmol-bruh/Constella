{
  "cli": { "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "env": { "CONSTELLA_DISTRIBUTION": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": { "CONSTELLA_DISTRIBUTION": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
