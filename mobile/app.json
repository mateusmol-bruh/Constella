
{
  "expo": {
    "name": "Constella",
    "slug": "constella",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "constella",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100D32"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
