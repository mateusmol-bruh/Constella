# URL acessível pelo celular, sem /api no final. Nunca inserir tokens aqui.
EXPO_PUBLIC_API_URL=
# ID público do projeto EAS real; não é chave secreta. Necessário para push no build instalado.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Caminho local/EAS do arquivo google-services.json real do Firebase para Android.
GOOGLE_SERVICES_JSON=
